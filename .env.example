# Copy to .env for `netlify dev` (gitignored). In production these live in
# Netlify → Site configuration → Environment variables.

# Boats only. Free key from https://aisstream.io — one concurrent connection
# per key, so a local `netlify dev` and the deployed site will fight over it.
# Without it /api/vessels returns 501 and every other feed still works.
AISSTREAM_API_KEY=
